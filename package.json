{
  "name": "duanap-hub",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 1026",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 1026",
    "typecheck": "next typegen && tsc --noEmit",
    "check:structural": "node scripts/verify.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:production": "tsx scripts/production-smoke.ts",
    "backup": "tsx --env-file-if-exists=.env.local scripts/backup.ts",
    "restore:drill": "tsx --env-file-if-exists=.env.local scripts/restore-drill.ts",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" *.json playwright.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "next": "16.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  }
}
