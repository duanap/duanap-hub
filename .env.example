# Copy to .env.local and keep the file out of Git.
HUB_SITE_URL=http://127.0.0.1:1026
HUB_DATA_DIR=./data
HUB_ADMIN_USERNAME=duanap
# Generate interactively with: node scripts/hash-password.mjs
# Keep the escaped dollar signs in its output: Next.js expands unescaped $ in dotenv files.
HUB_ADMIN_PASSWORD_HASH=
# Set to 1 only when the loopback reverse proxy overwrites X-Real-IP.
HUB_TRUST_PROXY=0
NEXT_TELEMETRY_DISABLED=1
