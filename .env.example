# Copy to .env.local and keep the file out of Git.
HUB_SITE_URL=http://127.0.0.1:1026
HUB_DATA_DIR=./data
HUB_ADMIN_USERNAME=duanap
# Generate interactively with: node scripts/hash-password.mjs
HUB_ADMIN_PASSWORD_HASH=

# P2 candidate: both this flag and the Studio accounts module must be enabled.
# Keep disabled until full WordPress/QQ/cache acceptance; secrets are server-only.
HUB_ACCOUNTS_ENABLED=0
# Independent P2 write gate; enable only after WordPress check-in acceptance.
HUB_CHECKIN_ENABLED=0
# Existing mode delegates QQ to the native blog login; independent-account mode
# uses the separate main-domain QQ credentials below. Does not enable accounts.
HUB_QQ_LOGIN_ENABLED=0
# Only for a separately verified SAME-application QQ callback relay.
# Separate main-site and blog QQ apps must keep this disabled.
HUB_QQ_CALLBACK_RELAY_ENABLED=0
HUB_WORDPRESS_URL=
HUB_WORDPRESS_CLIENT_ID=
HUB_WORDPRESS_CLIENT_SECRET=
# Generate 32 random bytes encoded as base64url (43 characters), store privately.
HUB_ACCOUNTS_TOKEN_KEY=

# Independent Hub members; keep off until the new identity backup and linking
# acceptance is complete. Does not import WordPress users or passwords.
HUB_LOCAL_ACCOUNTS_ENABLED=0
# Main-domain QQ application only. Keep the blog application's settings separate.
HUB_QQ_APP_ID=
HUB_QQ_APP_KEY=
# Optional: a shared identifier ONLY after QQ confirms the apps' UnionID scope.
HUB_QQ_UNION_REALM=
